PORT=5000

# ---- MongoDB ----
# Go to MongoDB Atlas → Database Access → edit user → "Edit Password" → set a NEW password.
# Then paste the new connection string here.
MONGODB_URI=mongodb+srv://archiejohn990_db_user:NEW_MONGODB_PASSWORD_HERE@cluster0.xeoc5xu.mongodb.net/student_project_hub?retryWrites=true&w=majority&appName=Cluster0

# ---- JWT ----
# Generate a fresh secret: run this in your terminal or PowerShell:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Then paste the output here. Do NOT reuse the old one.
JWT_SECRET=PASTE_NEW_64_BYTE_HEX_HERE

# ---- Admin account ----
# Change both to new values. ADMIN_PASSWORD should be 12+ chars with mixed case, digits, symbols.
ADMIN_EMAIL=archiejohn990@gmail.com
ADMIN_PASSWORD=CHANGE_ME_NOW_StrongPass!2026

# ---- Telegram bot ----
# Revoke the old bot token in BotFather:  /mybots → your bot → API Token → Revoke current token
# Then paste the new token here.
TELEGRAM_BOT_TOKEN=PASTE_NEW_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=StudentProjectHubBot
TELEGRAM_ADMIN_CHAT_ID=7720375373

# ---- CORS ----
